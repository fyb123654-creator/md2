<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mygame.ui.NetworkGameController" styleClass="lobby-root" style="-fx-padding: 18; -fx-spacing: 15;">

    <Label text="Monopoly Deal - Online Mode" style="-fx-font-size: 26px; -fx-font-weight: 800; -fx-text-fill: white;"/>

    <VBox fx:id="mainPanel" spacing="12" styleClass="overlay" style="-fx-padding: 16;">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Server Address:" style="-fx-font-size: 14px; -fx-min-width: 120px;"/>
            <TextField fx:id="serverAddressField" prefWidth="200" promptText="Enter server IP"/>
        </HBox>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Port:" style="-fx-font-size: 14px; -fx-min-width: 120px;"/>
            <TextField fx:id="portField" prefWidth="100" promptText="12345"/>
        </HBox>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Player Count:" style="-fx-font-size: 14px; -fx-min-width: 120px;"/>
            <HBox fx:id="playerCountButtonBox" spacing="8" alignment="CENTER_LEFT" visible="false" managed="false">
                <Button fx:id="playerCount2Button" text="2 Players" onAction="#onPlayerCount2Clicked"/>
                <Button fx:id="playerCount3Button" text="3 Players" onAction="#onPlayerCount3Clicked"/>
                <Button fx:id="playerCount4Button" text="4 Players" onAction="#onPlayerCount4Clicked"/>
                <Button fx:id="playerCount5Button" text="5 Players" onAction="#onPlayerCount5Clicked"/>
            </HBox>
        </HBox>

        <HBox spacing="15" alignment="CENTER">
            <Button fx:id="hostButton" text="Create Game" onAction="#onHostButtonClicked"
                    style="-fx-padding: 12 30; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-color: linear-gradient(#4CAF50, #45a049); -fx-text-fill: white; -fx-border-radius: 10; -fx-background-radius: 10;"/>
            <Button fx:id="joinButton" text="Join Game" onAction="#onJoinButtonClicked"
                    style="-fx-padding: 12 30; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-color: linear-gradient(#2196F3, #1976D2); -fx-text-fill: white; -fx-border-radius: 10; -fx-background-radius: 10;"/>
        </HBox>

        <HBox spacing="15" alignment="CENTER">
            <Button fx:id="readyButton" text="Ready" onAction="#onReadyClicked" styleClass="button primary"/>
            <Button fx:id="startButton" text="Start (Host)" onAction="#onStartClicked" disable="true" styleClass="button success"/>
        </HBox>

        <Label fx:id="hintLabel" text="Step 1: Click Ready. Step 2: Host clicks Start when everyone is Ready."
               styleClass="hint important"/>

        <Label fx:id="statusLabel" text="Ready to connect..." style="-fx-font-size: 14px; -fx-text-fill: #666;"/>
    </VBox>

    <HBox fx:id="gameArea" spacing="15" visible="false">
        <Label fx:id="turnInfoLabel" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

        <Label text="Game board will appear here" style="-fx-text-fill: #999;"/>

        <Button fx:id="endTurnButton" text="End Turn" onAction="#onEndTurnClicked"
                style="-fx-padding: 10 25; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-color: #f44336; -fx-text-fill: white; -fx-border-radius: 8; -fx-background-radius: 8;"/>
    </HBox>

    <VBox fx:id="playerInfoBox" spacing="10" visible="false">
        <Label text="Players:" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
        <HBox fx:id="playerListBox" spacing="10"/>
    </VBox>
</VBox>
